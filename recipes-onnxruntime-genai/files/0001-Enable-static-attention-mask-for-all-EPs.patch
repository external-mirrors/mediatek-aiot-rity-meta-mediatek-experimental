From 66d4c3b5f15fa09892ba704b6cd136c334016899 Mon Sep 17 00:00:00 2001
From: Suyash Narain <suyash.narain@mediatek.com>
Date: Fri, 27 Mar 2026 16:07:56 -0700
Subject: [PATCH] Enable static attention mask for all EPs

Signed-off-by: Suyash Narain <suyash.narain@mediatek.com>
---
 src/models/position_inputs.cpp | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/src/models/position_inputs.cpp b/src/models/position_inputs.cpp
index 3f6b8885..32683c1c 100644
--- a/src/models/position_inputs.cpp
+++ b/src/models/position_inputs.cpp
@@ -422,8 +422,7 @@ void DefaultPositionInputs::RewindMask(size_t index) {
 //   - NvTensorRtRtx with past-present shared buffers
 bool DefaultPositionInputs::ShouldUseStaticMaskHandling() const {
   return state_.params_->use_graph_capture ||
-         (state_.params_->IsPastPresentShareBufferEnabled(model_.config_->model.type) &&
-          model_.p_device_->GetType() == DeviceType::NvTensorRtRtx);
+         state_.params_->IsPastPresentShareBufferEnabled(model_.config_->model.type);
 }
 
 // TODO: SlidingWindow does not support graph capture
