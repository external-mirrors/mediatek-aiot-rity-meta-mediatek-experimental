/dts-v1/;
/plugin/;

#include "camera-common.dtsi"

/ {
	fragment@25 {
		target-path = "/soc";
		__overlay__ {
			kd_camera_hw1:kd-camera-hw1@1a003000 {
				compatible = "mediatek,imgsensor";
				reg = <0 0x1a003000 0 0x1000>;
				pinctrl-names = "default",
					"cam0_pnd0", "cam0_pnd1",
					"cam1_pnd0", "cam1_pnd1",
					"cam2_pnd0", "cam2_pnd1",
					"cam3_pnd0", "cam3_pnd1",
					"cam4_pnd0", "cam4_pnd1",
					"cam5_pnd0", "cam5_pnd1",
					"cam0_mclk_off",
					"cam0_mclk_2mA", "cam0_mclk_4mA",
					"cam0_mclk_6mA", "cam0_mclk_8mA",
					"cam1_mclk_off",
					"cam1_mclk_2mA", "cam1_mclk_4mA",
					"cam1_mclk_6mA", "cam1_mclk_8mA",
					"cam2_mclk_off",
					"cam2_mclk_2mA", "cam2_mclk_4mA",
					"cam2_mclk_6mA", "cam2_mclk_8mA",
					"cam3_mclk_off",
					"cam3_mclk_2mA", "cam3_mclk_4mA",
					"cam3_mclk_6mA", "cam3_mclk_8mA",
					"cam4_mclk_off",
					"cam4_mclk_2mA", "cam4_mclk_4mA",
					"cam4_mclk_6mA", "cam4_mclk_8mA",
					"cam5_mclk_off",
					"cam5_mclk_2mA", "cam5_mclk_4mA",
					"cam5_mclk_6mA", "cam5_mclk_8mA";
				pinctrl-0 = <&camera_pins_default>;
				pinctrl-1 = <&cam_port0_serdes_a0_pnd_0>;
				pinctrl-2 = <&cam_port0_serdes_a0_pnd_1>;
				pinctrl-3 = <&cam_port0_serdes_a1_pnd_0>;
				pinctrl-4 = <&cam_port0_serdes_a1_pnd_1>;
				pinctrl-5 = <&cam_port0_serdes_a2_pnd_0>;
				pinctrl-6 = <&cam_port0_serdes_a2_pnd_1>;
				pinctrl-7 = <&cam_port0_serdes_a3_pnd_0>;
				pinctrl-8 = <&cam_port0_serdes_a3_pnd_1>;
				pinctrl-9 = <&cam_port1_serdes_b0_pnd_0>;
				pinctrl-10 = <&cam_port1_serdes_b0_pnd_1>;
				pinctrl-11 = <&cam_port1_serdes_b1_pnd_0>;
				pinctrl-12 = <&cam_port1_serdes_b1_pnd_1>;

				pinctrl-13 = <&cam_port0_serdes_a0_mclk_off>;
				pinctrl-14 = <&cam_port0_serdes_a0_mclk_2ma>;
				pinctrl-15 = <&cam_port0_serdes_a0_mclk_4ma>;
				pinctrl-16 = <&cam_port0_serdes_a0_mclk_6ma>;
				pinctrl-17 = <&cam_port0_serdes_a0_mclk_8ma>;

				pinctrl-18 = <&cam_port0_serdes_a1_mclk_off>;
				pinctrl-19 = <&cam_port0_serdes_a1_mclk_2ma>;
				pinctrl-20 = <&cam_port0_serdes_a1_mclk_4ma>;
				pinctrl-21 = <&cam_port0_serdes_a1_mclk_6ma>;
				pinctrl-22 = <&cam_port0_serdes_a1_mclk_8ma>;

				pinctrl-23 = <&cam_port0_serdes_a2_mclk_off>;
				pinctrl-24 = <&cam_port0_serdes_a2_mclk_2ma>;
				pinctrl-25 = <&cam_port0_serdes_a2_mclk_4ma>;
				pinctrl-26 = <&cam_port0_serdes_a2_mclk_6ma>;
				pinctrl-27 = <&cam_port0_serdes_a2_mclk_8ma>;

				pinctrl-28 = <&cam_port0_serdes_a3_mclk_off>;
				pinctrl-29 = <&cam_port0_serdes_a3_mclk_2ma>;
				pinctrl-30 = <&cam_port0_serdes_a3_mclk_4ma>;
				pinctrl-31 = <&cam_port0_serdes_a3_mclk_6ma>;
				pinctrl-32 = <&cam_port0_serdes_a3_mclk_8ma>;

				pinctrl-33 = <&cam_port1_serdes_b0_mclk_off>;
				pinctrl-34 = <&cam_port1_serdes_b0_mclk_2ma>;
				pinctrl-35 = <&cam_port1_serdes_b0_mclk_4ma>;
				pinctrl-36 = <&cam_port1_serdes_b0_mclk_6ma>;
				pinctrl-37 = <&cam_port1_serdes_b0_mclk_8ma>;

				pinctrl-38 = <&cam_port1_serdes_b1_mclk_off>;
				pinctrl-39 = <&cam_port1_serdes_b1_mclk_2ma>;
				pinctrl-40 = <&cam_port1_serdes_b1_mclk_4ma>;
				pinctrl-41 = <&cam_port1_serdes_b1_mclk_6ma>;
				pinctrl-42 = <&cam_port1_serdes_b1_mclk_8ma>;

				cam0-pin-mclk = "mclk";
				cam0-pin-pdn = "gpio";
				cam0-pin-vcama = "regulator";
				cam0-vcama-supply = <&mt6359_vcamio_ldo_reg>;

				cam1-pin-mclk = "mclk";
				cam1-pin-pdn = "gpio";
				cam1-pin-vcama = "regulator";
				cam1-vcama-supply = <&mt6359_vcamio_ldo_reg>;

				cam2-pin-mclk = "mclk";
				cam2-pin-pdn = "gpio";
				cam2-pin-vcama = "regulator";
				cam2-vcama-supply = <&mt6359_vcamio_ldo_reg>;

				cam3-pin-mclk = "mclk";
				cam3-pin-pdn = "gpio";
				cam3-pin-vcama = "regulator";
				cam3-vcama-supply = <&mt6359_vcamio_ldo_reg>;

				cam4-pin-mclk = "mclk";
				cam4-pin-pdn = "gpio";
				cam4-pin-vcama = "regulator";
				cam4-vcama-supply = <&mt6359_vcamio_ldo_reg>;

				cam5-pin-mclk = "mclk";
				cam5-pin-pdn = "gpio";
				cam5-pin-vcama = "regulator";
				cam5-vcama-supply = <&mt6359_vcamio_ldo_reg>;
				status = "okay";
			};
		};
	};

	fragment@26 {
		target = <&i2c7>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&i2c7_pins>;
			clock-frequency = <400000>;
			camera_main_mtk:camera-main@1a {
				compatible = "mediatek,camera_main";
				#thermal-sensor-cells = <0>;
				reg = <0x1a>;
				status = "okay";
				mclk-index  = <0>;   /* CMMCLK0 */
				csi-port    = <0>;
			};
			camera_sub_mtk:camera-sub@1b {
				compatible = "mediatek,camera_sub";
				#thermal-sensor-cells = <0>;
				reg = <0x1b>;
				status = "okay";
				mclk-index  = <0>;   /* CMMCLK0 */
				csi-port    = <0>;
			};

			camera_main2_mtk:camera-main2@1c {
				compatible = "mediatek,camera_main_two";
				#thermal-sensor-cells = <0>;
				reg = <0x1c>;
				status = "okay";
				mclk-index  = <0>;   /* CMMCLK0 */
				csi-port    = <0>;
			};

			camera_sub2_mtk:camera-sub2@1d {
				compatible = "mediatek,camera_sub_two";
				#thermal-sensor-cells = <0>;
				reg = <0x1d>;
				status = "okay";
				mclk-index  = <0>;   /* CMMCLK0 */
				csi-port    = <0>;
			};
		};
	};

	fragment@27 {
		target = <&i2c8>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&i2c8_pins>;
			clock-frequency = <400000>;
			camera_main3_mtk:camera-main3@2a {
				compatible = "mediatek,camera_main_three";
				#thermal-sensor-cells = <0>;
				reg = <0x2a>;
				status = "okay";
				mclk-index  = <1>;   /* CMMCLK1 */
				csi-port    = <1>;
			};
			camera_sub3_mtk:camera-sub3@2b {
				compatible = "mediatek,camera_sub_three";
				#thermal-sensor-cells = <0>;
				reg = <0x2b>;
				status = "okay";
				mclk-index  = <1>;   /* CMMCLK1 */
				csi-port    = <1>;
			};
		};
	};
};
