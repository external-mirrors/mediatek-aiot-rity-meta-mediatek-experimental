From 3224b5af57bfbd4dc6b077f46c739e97e74706a7 Mon Sep 17 00:00:00 2001
From: Felix Freimann <ffr@sonic.net>
Date: Mon, 5 Jan 2026 12:17:10 -0800
Subject: [PATCH] Jailhouse memory reservation and UART settings.

---
 arch/arm64/boot/dts/mediatek/mt8370-genio-510-evk.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt8370-genio-510-evk.dts b/arch/arm64/boot/dts/mediatek/mt8370-genio-510-evk.dts
index 4bdc53917bcb..9e6e2fb95352 100644
--- a/arch/arm64/boot/dts/mediatek/mt8370-genio-510-evk.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8370-genio-510-evk.dts
@@ -26,6 +26,7 @@ / {
 	aliases {
 		ethernet0 = &eth;
 		serial0 = &uart0;
+		serial2 = &uart2;
 		dsi0 = &dsi0;
 	};
 
@@ -133,6 +134,12 @@ afe_dma_mem_reserved: snd-dma-mem-region {
 			reg = <0 0x61000000 0 0x800000>;
 			no-map;
 		};
+
+        /* Jailhouse hypervisor */
+        jailhouse: jailhouse@0x6ac00000 {
+            reg = <0 0x6ac00000 0 0x00400000>;
+            no-map;
+        };
 	};
 
 	common_fixed_5v: regulator-0 {
@@ -1320,6 +1327,8 @@ &uart1 {
 &uart2 {
 	pinctrl-0 = <&uart2_pins>;
 	pinctrl-names = "default";
+    /delete-property/ dmas;
+    /delete-property/ dma-names;
 	status = "okay";
 };
 
-- 
2.34.1

