From c5efa9a6adc4d61e2be071f4d5aa331e5af5dc2e Mon Sep 17 00:00:00 2001
From: Felix Freimann <felix.freimann@mediatek.com>
Date: Thu, 19 Feb 2026 14:08:01 -0800
Subject: [PATCH] Jailhouse memory reservation and UART settings.

---
 arch/arm64/boot/dts/mediatek/mt8390-genio-700-evk.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt8390-genio-700-evk.dts b/arch/arm64/boot/dts/mediatek/mt8390-genio-700-evk.dts
index 0c54a368a30d..5007d59e8dc8 100644
--- a/arch/arm64/boot/dts/mediatek/mt8390-genio-700-evk.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8390-genio-700-evk.dts
@@ -26,6 +26,7 @@ / {
 	aliases {
 		ethernet0 = &eth;
 		serial0 = &uart0;
+		serial2 = &uart2;
 		dsi0 = &dsi0;
 	};
 
@@ -125,6 +126,12 @@ afe_dma_mem_reserved: adsp-dma-mem-region {
 			reg = <0 0x61000000 0 0x800000>;
 			no-map;
 		};
+
+        /* Jailhouse hypervisor */
+        jailhouse: jailhouse@0x6ac00000 {
+            reg = <0 0x6ac00000 0 0x00400000>;
+            no-map;
+        };
 	};
 
 	common_fixed_5v: regulator-0 {
@@ -1314,6 +1321,8 @@ &uart1 {
 &uart2 {
 	pinctrl-0 = <&uart2_pins>;
 	pinctrl-names = "default";
+    /delete-property/ dmas;
+    /delete-property/ dma-names;
 	status = "okay";
 };
 
-- 
2.34.1

