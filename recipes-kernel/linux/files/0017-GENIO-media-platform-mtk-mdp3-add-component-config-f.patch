From d1740a786717d517c085929655a4fc857608cbd1 Mon Sep 17 00:00:00 2001
From: Moudy Ho <moudy.ho@mediatek.com>
Date: Wed, 18 Mar 2026 15:32:41 +0800
Subject: [PATCH 17/35] GENIO: media: platform: mtk-mdp3: add component config
 for MT8195

Add support for existing component algorithm.

Change-Id: I2755753c88da4e385ae0718892afc002a5fe5b79
Signed-off-by: Moudy Ho <moudy.ho@mediatek.com>
---
 .../platform/mediatek/mdp3/mdp_alg_core.c     | 17 +++++
 .../platform/mediatek/mdp3/mdp_alg_rdma.c     | 24 +++++-
 .../platform/mediatek/mdp3/mdp_alg_rsz.c      | 76 ++++++++++++++++++-
 .../platform/mediatek/mdp3/mdp_alg_wrot.c     | 26 ++++++-
 .../platform/mediatek/mdp3/mtk-mdp3-alg.h     |  1 +
 5 files changed, 135 insertions(+), 9 deletions(-)

diff --git a/drivers/media/platform/mediatek/mdp3/mdp_alg_core.c b/drivers/media/platform/mediatek/mdp3/mdp_alg_core.c
index 3bf580618bc1..b20fb6983430 100644
--- a/drivers/media/platform/mediatek/mdp3/mdp_alg_core.c
+++ b/drivers/media/platform/mediatek/mdp3/mdp_alg_core.c
@@ -147,11 +147,22 @@ static int config_path_clk_ctrl(struct mdp_alg_task *task, u32 pipe, bool clear)
 
 	for (i = 0; i < path->node_cnt; i++) {
 		struct mdp_comp *comp = path->nodes[i].comp;
+		const struct mdp_comp_blend *b;
 
 		if (clear)
 			mdp_comp_clock_off(dev, comp);
 		else
 			mdp_comp_clock_on(dev, comp);
+
+		b = &task->mdp->mdp_data->comp_data[comp->public_id].blend;
+		if (b && b->aid_clk) {
+			struct mdp_comp *blend = task->mdp->comp[b->b_id];
+
+			if (clear)
+				mdp_comp_clock_off(dev, blend);
+			else
+				mdp_comp_clock_on(dev, blend);
+		}
 	}
 
 	if (!clear)
@@ -164,17 +175,23 @@ static int config_mutex_mod_ctrl(struct mdp_alg_task *task, u32 pipe, bool clear
 {
 	struct mdp_alg_path_tp *path = &task->cfg.path[pipe];
 	struct mtk_mutex *mutex;
+	const struct mtk_mdp_driver_data *data = task->mdp->mdp_data;
 	const u32 *mutex_idx = task->mdp->mdp_data->mdp_mutex_table_idx;
 	int ret, i;
 
 	mutex = task->mdp->mm_subsys[path->mmsys_idx].mdp_mutex[path->mutex_idx];
 	for (i = 0; i < path->node_cnt; i++) {
 		struct mdp_comp *comp = path->nodes[i].comp;
+		const struct mdp_comp_blend *b;
 		u32 id = comp->public_id;
 
 		ret = mtk_mutex_write_mod(mutex, mutex_idx[id], clear);
 		if (ret)
 			return ret;
+
+		b = &data->comp_data[id].blend;
+		if (b && b->aid_mod)
+			mtk_mutex_write_mod(mutex, mutex_idx[b->b_id], clear);
 	}
 
 	return 0;
diff --git a/drivers/media/platform/mediatek/mdp3/mdp_alg_rdma.c b/drivers/media/platform/mediatek/mdp3/mdp_alg_rdma.c
index 7bd236d80a48..2362bb080492 100644
--- a/drivers/media/platform/mediatek/mdp3/mdp_alg_rdma.c
+++ b/drivers/media/platform/mediatek/mdp3/mdp_alg_rdma.c
@@ -20,6 +20,16 @@ static const struct rdma_data mt8189_rdma_data = {
 	.rb_swap = 2,
 };
 
+static const struct rdma_data mt8195_rdma_main_data = {
+	.tile_width = 2048,
+	.rb_swap = 2,
+};
+
+static const struct rdma_data mt8195_rdma_sub_data = {
+	.tile_width = 640,
+	.rb_swap = 2,
+};
+
 struct rdma_frame_data {
 	u8 enable_ufo;
 	u8 hw_fmt;
@@ -51,11 +61,19 @@ static inline struct rdma_frame_data *rdma_frm_data(struct mdp_alg_path_tp *path
 	return path->nodes[n].data;
 }
 
-static inline const struct rdma_data *get_private_data(struct mdp_alg_task *task)
+static inline const struct rdma_data *get_private_data(struct mdp_alg_task *task,
+						       struct mdp_alg_path_tp *path,
+						       u32 n)
 {
 	switch (task->mdp->mdp_data->mdp_alg_plat) {
 	case MDP_ALG_MT8189:
 		return &mt8189_rdma_data;
+	case MDP_ALG_MT8195:
+		if (path->nodes[n].id == MDP_COMP_RDMA2 ||
+		    path->nodes[n].id == MDP_COMP_RDMA3)
+			return &mt8195_rdma_main_data;
+		else
+			return &mt8195_rdma_sub_data;
 	default:
 		return 0;
 	}
@@ -265,7 +283,7 @@ static int rdma_prepare(struct mdp_alg_task *task,
 static int rdma_config_frame(struct mdp_alg_task *task,
 			     struct mdp_alg_path_tp *path, u32 n)
 {
-	const struct rdma_data *rdma = get_private_data(task);
+	const struct rdma_data *rdma = get_private_data(task, path, n);
 	struct mdp_alg_frame_config *cfg = &task->cfg;
 	struct rdma_frame_data *rdma_frm = rdma_frm_data(path, n);
 	struct mdp_alg_path_node *node = &path->nodes[n];
@@ -586,7 +604,7 @@ static int rdma_tile_prepare(struct mdp_alg_task *task,
 	struct img_ipi_frameparam *param = task->cfg.param;
 	struct img_image_buffer *src_buf = &param->inputs[0].buffer;
 	u32 src_fmt = src_buf->format.colorformat;
-	const struct rdma_data *rdma = get_private_data(task);
+	const struct rdma_data *rdma = get_private_data(task, path, n);
 
 	if (!rdma)
 		return -EINVAL;
diff --git a/drivers/media/platform/mediatek/mdp3/mdp_alg_rsz.c b/drivers/media/platform/mediatek/mdp3/mdp_alg_rsz.c
index e8714aabbe2a..dd5f88fe6662 100644
--- a/drivers/media/platform/mediatek/mdp3/mdp_alg_rsz.c
+++ b/drivers/media/platform/mediatek/mdp3/mdp_alg_rsz.c
@@ -4,6 +4,7 @@
  * Author: Chris-YC Chen <chris-yc.chen@mediatek.com>
  */
 
+#include "mdp_reg_merge.h"
 #include "mdp_reg_rsz.h"
 #include "mdp_tile_core.h"
 #include "mdp_tile_comp.h"
@@ -28,6 +29,14 @@ static const struct rsz_data mt8189_rsz_data = {
 	.tile_width = 516,
 };
 
+static const struct rsz_data mt8195_rsz_main_data = {
+	.tile_width = 1952,
+};
+
+static const struct rsz_data mt8195_rsz_sub_data = {
+	.tile_width = 560,
+};
+
 struct rsz_cal_in {
 	u32 in_width;
 	u32 in_height;
@@ -109,11 +118,19 @@ static inline struct rsz_frame_data *rsz_frm_data(struct mdp_alg_path_tp *path,
 	return path->nodes[n].data;
 }
 
-static inline const struct rsz_data *get_private_data(struct mdp_alg_task *task)
+static inline const struct rsz_data *get_private_data(struct mdp_alg_task *task,
+						      struct mdp_alg_path_tp *path,
+						      u32 n)
 {
 	switch (task->mdp->mdp_data->mdp_alg_plat) {
 	case MDP_ALG_MT8189:
 		return &mt8189_rsz_data;
+	case MDP_ALG_MT8195:
+		if (path->nodes[n].id == MDP_COMP_RSZ2 ||
+		    path->nodes[n].id == MDP_COMP_RSZ3)
+			return &mt8195_rsz_main_data;
+		else
+			return &mt8195_rsz_sub_data;
 	default:
 		return 0;
 	}
@@ -811,6 +828,13 @@ static int rsz_config_init(struct mdp_alg_task *task,
 
 	cmdq_pkt_write_value_addr(pkt, base_pa + PRZ_ENABLE, 0x1, U32_MAX);
 
+	if (task->mdp->mdp_data->mdp_alg_plat == MDP_ALG_MT8195) {
+		struct device *dev;
+
+		dev = task->mdp->mm_subsys[MDP_MM_SUBSYS_1].mmsys;
+		mtk_mmsys_vpp_rsz_dcm_config(dev, true, pkt);
+	}
+
 	return 0;
 }
 
@@ -888,9 +912,57 @@ static int rsz_config_tile(struct mdp_alg_task *task,
 				  tile->chroma.x, U32_MAX);
 	cmdq_pkt_write_value_addr(pkt, base_pa + PRZ_CHROMA_HORIZONTAL_SUBPIXEL_OFFSET,
 				  tile->chroma.x_sub, U32_MAX);
+
 	cmdq_pkt_write_value_addr(pkt, base_pa + PRZ_OUTPUT_IMAGE,
 				  (rsz_output_h << 16) + rsz_output_w, U32_MAX);
 
+	if (task->mdp->mdp_data->mdp_alg_plat == MDP_ALG_MT8195) {
+		struct device *dev;
+		struct mdp_comp *merge;
+		enum mtk_mdp_comp_id public_id = path->nodes[n].id;
+		u32 inner_id;
+		u32 rsz_switch, merge_cfg;
+
+		switch (public_id) {
+		case MDP_COMP_RSZ2:
+			merge = task->mdp->comp[MDP_COMP_MERGE2];
+			break;
+		case MDP_COMP_RSZ3:
+			merge = task->mdp->comp[MDP_COMP_MERGE3];
+			break;
+		default:
+			goto rsz_tile_done;
+		}
+
+		if (rsz_input_h >= rsz_output_h) {
+			rsz_switch = 0;
+			merge_cfg = (rsz_output_h << 16) | rsz_output_w;
+		} else {
+			rsz_switch = 0x1;
+			merge_cfg = (rsz_input_h << 16) | rsz_input_w;
+		}
+
+		inner_id = merge->alias_id;
+		dev = task->mdp->mm_subsys[MDP_MM_SUBSYS_1].mmsys;
+		mtk_mmsys_vpp_rsz_merge_config(dev, inner_id, rsz_switch, pkt);
+
+		cmdq_pkt_write_value_addr(pkt, merge->reg_base + MDP_MERGE_CFG_0,
+					  merge_cfg, U32_MAX);
+		cmdq_pkt_write_value_addr(pkt,  merge->reg_base + MDP_MERGE_CFG_4,
+					  merge_cfg, U32_MAX);
+		cmdq_pkt_write_value_addr(pkt,  merge->reg_base + MDP_MERGE_CFG_24,
+					  merge_cfg, U32_MAX);
+		cmdq_pkt_write_value_addr(pkt,  merge->reg_base + MDP_MERGE_CFG_25,
+					  merge_cfg, U32_MAX);
+
+		/* Bypass mode */
+		cmdq_pkt_write_value_addr(pkt,  merge->reg_base + MDP_MERGE_CFG_12,
+					  BIT(0), U32_MAX);
+		cmdq_pkt_write_value_addr(pkt,  merge->reg_base + MDP_MERGE_ENABLE,
+					  BIT(0), U32_MAX);
+	}
+
+rsz_tile_done:
 	return 0;
 }
 
@@ -908,7 +980,7 @@ static int rsz_tile_prepare(struct mdp_alg_task *task,
 	const struct img_frame *frame_in = &cfg->frame_in;
 	const struct img_frame *frame_out = &cfg->frame_out[node->out_idx];
 	const struct img_crop *crop = &cfg->frame_in_crop[node->out_idx];
-	const struct rsz_data *rsz = get_private_data(task);
+	const struct rsz_data *rsz = get_private_data(task, path, n);
 	const u8 rotate = cfg->out_rotate[node->out_idx];
 
 	if (!rsz)
