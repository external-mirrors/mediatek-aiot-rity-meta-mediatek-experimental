 static int tp_select_path_mt8189(struct mdp_alg_task *task)
 {
 	struct mdp_alg_frame_config *cfg = &task->cfg;
-	struct mdp_alg_path_tp *p = &cfg->path[TP_PATH_NO_PQ_P0];
+	struct mdp_alg_path_tp *p = &cfg->path[MDP_ALG_1ST_PIPE];
 	int ret;
 
 	ret = tp_parse_path(task->mdp, p, mt8189_path_map[TP_PATH_NO_PQ_P0]);
 	if (ret)
 		return ret;
-	p->path_id = TP_PATH_NO_PQ_P0;
-	p->mmsys_idx = TP_PATH_NO_PQ_P0;
-	p->mutex_idx = TP_PATH_NO_PQ_P0;
+	p->path_id = MDP_ALG_1ST_PIPE;
+	p->mmsys_idx = MDP_ALG_1ST_PIPE;
+	p->mutex_idx = MDP_ALG_1ST_PIPE;
 
 	if (cfg->param->type == MDP_STREAM_TYPE_DUAL_BITBLT) {
-		p = &cfg->path[TP_PATH_NO_PQ_P1];
+		p = &cfg->path[MDP_ALG_2ND_PIPE];
 		ret = tp_parse_path(task->mdp, p, mt8189_path_map[TP_PATH_NO_PQ_P1]);
 		if (ret)
 			return ret;
-		p->path_id = TP_PATH_NO_PQ_P1;
-		p->mmsys_idx = TP_PATH_NO_PQ_P0;
-		p->mutex_idx = TP_PATH_NO_PQ_P1;
+		p->path_id = MDP_ALG_2ND_PIPE;
+		p->mmsys_idx = MDP_ALG_1ST_PIPE;
+		p->mutex_idx = MDP_ALG_2ND_PIPE;
+		cfg->dual = true;
+	}
+
+	return ret;
+}
+
+static int tp_select_path_mt8195(struct mdp_alg_task *task)
+{
+	struct mdp_alg_frame_config *cfg = &task->cfg;
+	struct mdp_alg_path_tp *p = &cfg->path[MDP_ALG_1ST_PIPE];
+	int ret;
+
+	ret = tp_parse_path(task->mdp, p, mt8195_path_map[TP_PATH_FULL_PQ_P0]);
+	if (ret)
+		return ret;
+	p->path_id = MDP_ALG_1ST_PIPE;
+	p->mutex_idx = MDP_ALG_1ST_PIPE;
+
+	if (cfg->param->type == MDP_STREAM_TYPE_DUAL_BITBLT) {
+		p = &cfg->path[MDP_ALG_2ND_PIPE];
+		ret = tp_parse_path(task->mdp, p, mt8195_path_map[TP_PATH_FULL_PQ_P1]);
+		if (ret)
+			return ret;
+		p->path_id = MDP_ALG_1ST_PIPE;
+		p->mutex_idx = MDP_ALG_2ND_PIPE;
 		cfg->dual = true;
 	}
 
@@ -171,6 +456,8 @@ int mdp_alg_tp_select_path(struct mdp_alg_task *task)
 	switch (task->mdp->mdp_data->mdp_alg_plat) {
 	case MDP_ALG_MT8189:
 		return tp_select_path_mt8189(task);
+	case MDP_ALG_MT8195:
+		return tp_select_path_mt8195(task);
 	default:
 		return -EINVAL;
 	}
