+static bool need_resize(const struct mdp_alg_frame_config *cfg)
+{
+	u32 srcw = cfg->param->inputs[0].buffer.format.width;
+	u32 srch = cfg->param->inputs[0].buffer.format.height;
+	u32 outw = cfg->param->outputs[0].buffer.format.width;
+	u32 outh = cfg->param->outputs[0].buffer.format.height;
+	struct img_crop *crop = &cfg->param->outputs[0].crop;
+
+	if (crop->width == srcw &&
+	    srcw == outw &&
+	    crop->height == srch &&
+	    srch == outh &&
+	    crop->left_subpix == 0 &&
+	    crop->top_subpix == 0 &&
+	    crop->width_subpix == 0 &&
+	    crop->height_subpix == 0)
+		return false;
+
+	return true;
+}
+
+static bool check_alpha_rotate(struct mdp_alg_task *task)
+{
+	struct img_ipi_frameparam *p = task->cfg.param;
+	struct img_image_buffer *src_buf = &p->inputs[0].buffer;
+	struct img_image_buffer *dst_buf = &p->outputs[0].buffer;
+	u32 src_fmt = src_buf->format.colorformat;
+	u32 dst_fmt = dst_buf->format.colorformat;
+	bool alpha = false, rsz_enable;
+
+	if (MDP_COLOR_IS_ALPHA(src_fmt) && MDP_COLOR_IS_ALPHA(dst_fmt))
+		alpha = true;
+
+	rsz_enable = need_resize(&task->cfg);
+
+	return (alpha && rsz_enable);
+}
