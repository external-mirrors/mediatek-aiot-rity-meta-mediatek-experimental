+static void config_mutex_sof_ctrl(struct mdp_alg_task *task, u32 pipe, bool clear)
+{
+	struct mdp_alg_path_tp *path = &task->cfg.path[pipe];
+	struct cmdq_pkt *pkt = task->pkts[pipe];
+	int i;
+
+	for (i = 0; i < path->node_cnt; i++) {
+		struct mdp_comp *comp = path->nodes[i].comp;
+		s32 event = comp->gce_event[MDP_GCE_EVENT_SOF];
+
+		if (comp->type == MDP_COMP_TYPE_DUMMY)
+			continue;
+
+		if (event == MDP_GCE_NO_EVENT)
+			continue;
+
+		if (clear)
+			cmdq_pkt_clear_event(pkt, event);
+
+		/* HDMI-RX stream_done event need wait at initial position */
+		if (comp->public_id == MDP_COMP_SPLIT ||
+		    comp->public_id == MDP_COMP_SPLIT2)
+			continue;
+
+		if (!clear)
+			cmdq_pkt_wfe(pkt, event, true);
+	}
+}
