+};
+
+
 static const struct tp_map mt8189_path_map[TP_PATH_MAX][MDP_ALG_MAX_PATH_NODES] = {
 	[TP_PATH_NO_PQ_P0] = {
 		{MDP_COMP_RDMA0, {
@@ -399,6 +438,34 @@ static int tp_parse_path(struct mdp_dev *mdp, struct mdp_alg_path_tp *p,
 	return 0;
 }
 
+static int tp_select_path_mt8171(struct mdp_alg_task *task)
+{
+	struct mdp_alg_frame_config *cfg = &task->cfg;
+	struct mdp_alg_path_tp *p = &cfg->path[MDP_ALG_1ST_PIPE];
+	int ret;
+
+	ret = tp_parse_path(task->mdp, p, mt8171_path_map[TP_PATH_NO_PQ_P0]);
+	if (ret)
+		return ret;
+	p->path_id = MDP_ALG_1ST_PIPE;
+	p->mmsys_idx = MDP_ALG_1ST_PIPE;
+	p->mutex_idx = MDP_ALG_1ST_PIPE;
+
+	if (cfg->param->type == MDP_STREAM_TYPE_DUAL_BITBLT) {
+		p = &cfg->path[MDP_ALG_2ND_PIPE];
+		ret = tp_parse_path(task->mdp, p, mt8171_path_map[TP_PATH_NO_PQ_P1]);
+		if (ret)
+			return ret;
+		p->path_id = MDP_ALG_2ND_PIPE;
+		p->mmsys_idx = MDP_ALG_1ST_PIPE;
+		p->mutex_idx = MDP_ALG_2ND_PIPE;
+		cfg->dual = true;
+	}
+
+	return ret;
+}
+
