+		}},
+		{MDP_COMP_RSZ1, {
+			{MDP_COMP_WROT1, {
+				{MDP_MUX_MT8171_RSZ1_SOUT_SEL, 0x1, MDP_MUX_SOUT},
+				{MDP_MUX_MT8171_WROT1_SEL_IN, 0x2, MDP_MUX_SELIN},
+				{MDP_MUX_MT8171_BYP1_SEL_IN, 0x1, MDP_MUX_SELIN},
+			}},
+		}},
+		{MDP_COMP_WROT1, {
+		}},
