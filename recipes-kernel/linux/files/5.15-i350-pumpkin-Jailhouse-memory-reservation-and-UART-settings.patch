From f8b0d077744ac9644f097038e5eb776612ca2b8a Mon Sep 17 00:00:00 2001
From: Felix Freimann <ffr@sonic.net>
Date: Mon, 5 Jan 2026 17:09:11 -0800
Subject: [PATCH] Jailhouse memory reservation and UART settings.

---
 .../boot/dts/mediatek/mt8365-pumpkin.dts      | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt8365-pumpkin.dts b/arch/arm64/boot/dts/mediatek/mt8365-pumpkin.dts
index bee3537a4e5f..b4a5a38805b2 100644
--- a/arch/arm64/boot/dts/mediatek/mt8365-pumpkin.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8365-pumpkin.dts
@@ -18,6 +18,7 @@ / {
 
 	aliases {
 		serial0 = &uart0;
+		serial1 = &uart1;
 		mmc0 = &mmc0;
 		mmc1 = &mmc1;
 		mmc2 = &mmc2;
@@ -102,6 +103,10 @@ vpu_ram: vpu_ram@0x60000000 {
 			no-map;
 			linux,cma-default;
 		};
+        jailhouse: jailhouse@0x66c00000 {
+            reg = <0 0x66c00000 0 0x00400000>;
+            no-map;
+        };
 	};
 
 	ntc@0 {
@@ -182,6 +187,14 @@ &uart0 {
 	status = "okay";
 };
 
+&uart1 {
+	pinctrl-0 = <&uart1_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+};
+
 &mmc0 {
 	status = "okay";
 	pinctrl-names = "default", "state_uhs";
@@ -623,6 +636,13 @@ pins_i2c {
 		};
 	};
 
+	uart1_pins: uart1-pins {
+		pins {
+			pinmux = <MT8365_PIN_37_URXD1__FUNC_URXD1>,
+				 <MT8365_PIN_38_UTXD1__FUNC_UTXD1>;
+		};
+	};
+
 	ctp_pins: touchscreen-pins {
 		pin_reset {
 			pinmux = <MT8365_PIN_79_CMVSYNC__FUNC_GPIO79>;
-- 
2.34.1

