diff --git a/drivers/media/platform/mediatek/mdp3/mdp_alg_aal.c b/drivers/media/platform/mediatek/mdp3/mdp_alg_aal.c
new file mode 100644
index 000000000000..192de5582841
--- /dev/null
+++ b/drivers/media/platform/mediatek/mdp3/mdp_alg_aal.c
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2026 MediaTek Inc.
+ * Author: Dennis-YC Hsieh <dennis-yc.hsieh@mediatek.com>
+ */
+
+#include "mdp_reg_aal.h"
+#include "mdp_tile_core.h"
+#include "mdp_tile_comp.h"
+#include "mtk-mdp3-alg.h"
+#include "mtk-mdp3-core.h"
+
+struct aal_data {
+	u32 min_tile_width;
+	u32 tile_width;
+	u32 min_hist_width;
+	bool crop;
+};
+
+static const struct aal_data mt8195_aal_main_data = {
+	.tile_width = 1968,
+	.min_tile_width = 50,
+	.min_hist_width = 128,
+	.crop = true,
+};
+
+static const struct aal_data mt8195_aal_sub_data = {
+	.tile_width = 576,
+	.min_tile_width = 50,
+	.min_hist_width = 128,
+	.crop = true,
+};
+
+struct aal_frame_data {
+	bool relay_mode;
+};
+
+static inline struct aal_frame_data *aal_frm_data(struct mdp_alg_path_tp *path, u32 n)
+{
+	return path->nodes[n].data;
+}
+
+static inline const struct aal_data *get_private_data(struct mdp_alg_task *task,
+						      struct mdp_alg_path_tp *path,
+						      u32 n)
+{
+	switch (task->mdp->mdp_data->mdp_alg_plat) {
+	case MDP_ALG_MT8195:
+		if (path->nodes[n].id == MDP_COMP_AAL2 ||
+		    path->nodes[n].id == MDP_COMP_AAL3)
+			return &mt8195_aal_main_data;
+		else
+			return &mt8195_aal_sub_data;
+	default:
+		return 0;
+	}
+}
+
+static int aal_prepare(struct mdp_alg_task *task,
+		       struct mdp_alg_path_tp *path, u32 n)
+{
+	struct aal_frame_data *aal_frm;
+
+	aal_frm = kzalloc(sizeof(*aal_frm), GFP_KERNEL);
+	if (!aal_frm)
+		return -ENOMEM;
+	path->nodes[n].data = (void *)aal_frm;
+
+	return 0;
+}
+
+static int aal_config_init(struct mdp_alg_task *task,
+			   struct mdp_alg_path_tp *path, u32 n)
+{
+	const phys_addr_t base_pa = path->nodes[n].comp->reg_base;
+	struct cmdq_pkt *pkt = task->pkts[path->path_id];
+
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_AAL_EN, BIT(0), BIT(0));
+
+	return 0;
+}
+
+static int aal_config_frame(struct mdp_alg_task *task,
+			    struct mdp_alg_path_tp *path, u32 n)
+{
+	const phys_addr_t base_pa = path->nodes[n].comp->reg_base;
+	struct cmdq_pkt *pkt = task->pkts[path->path_id];
+	struct img_ipi_frameparam *p = task->cfg.param;
+	struct img_image_buffer *src_buf = &p->inputs[0].buffer;
+	struct img_image_buffer *dst_buf = &p->outputs[0].buffer;
+	u32 cfg_main = BIT(7);
+
+	if (MDP_COLOR_IS_10BIT_PACKED(src_buf->format.colorformat) ||
+	    MDP_COLOR_IS_10BIT_PACKED(dst_buf->format.colorformat))
+		cfg_main = 0;
+
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_AAL_CFG_MAIN,
+				  cfg_main, BIT(7));
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_AAL_CFG, BIT(0), BIT(0));
+
+	return 0;
+}
+
+static int aal_config_tile(struct mdp_alg_task *task,
+			   struct mdp_alg_path_tp *path,
+			   u32 n, u32 t)
+{
+	struct mdp_alg_tile_engine *tile = config_get_tile(task, path, n, t);
+	struct cmdq_pkt *pkt = task->pkts[path->path_id];
+	const phys_addr_t base_pa = path->nodes[n].comp->reg_base;
+	u32 aal_input_w, aal_input_h;
+	u32 aal_output_w, aal_output_h;
+	u32 aal_crop_x_offset, aal_crop_y_offset;
+
+	aal_input_w = tile->in.xe - tile->in.xs + 1;
+	aal_input_h = tile->in.ye - tile->in.ys + 1;
+	aal_output_w = tile->out.xe - tile->out.xs + 1;
+	aal_output_h = tile->out.ye - tile->out.ys + 1;
+	aal_crop_x_offset = tile->out.xs - tile->in.xs;
+	aal_crop_y_offset = tile->out.ys - tile->in.ys;
+
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_AAL_SIZE,
+				  (aal_input_w << 16) + aal_input_h, U32_MAX);
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_AAL_OUTPUT_OFFSET,
+				  (aal_crop_x_offset << 16) + aal_crop_y_offset,
+				  U32_MAX);
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_AAL_OUTPUT_SIZE,
+				  (aal_output_w << 16) + aal_output_h, U32_MAX);
+
+	return 0;
+}
+
+static int aal_tile_prepare(struct mdp_alg_task *task,
+			    struct mdp_alg_path_tp *path,
+			    u32 n,
+			    struct tile_func_block *func,
+			    union mdl_alg_tile_data *data)
+{
+	struct aal_frame_data *aal_frm = aal_frm_data(path, n);
+	struct mdp_alg_frame_config *cfg = &task->cfg;
+	const struct aal_data *aal = get_private_data(task, path, n);
+
+	func->for_func = tile_aal_for;
+	func->enable_flag = true;
+
+	func->full_size_x_in = cfg->frame_tile_sz.width;
+	func->full_size_y_in = cfg->frame_tile_sz.height;
+	func->full_size_x_out = func->full_size_x_in;
+	func->full_size_y_out = func->full_size_y_in;
+
+	func->in_tile_width = aal->tile_width;
+	func->out_tile_width = aal->tile_width;
+	func->in_tile_height = 65535;
+	func->out_tile_height = 65535;
+
+	if (aal->crop) {
+		func->l_tile_loss = 8;
+		func->r_tile_loss = 8;
+	} else {
+		func->l_tile_loss = 0;
+		func->r_tile_loss = 0;
+	}
+	func->in_min_width = min_t(u32, aal->min_hist_width, func->full_size_x_in);
+	func->in_min_width = max_t(u32, func->in_min_width, aal->min_tile_width);
+
+	return 0;
+}
+
+const struct mdp_alg_comp_ops alg_ops_aal = {
+	.comp_prepare = aal_prepare,
+	.comp_init = aal_config_init,
+	.config_frame = aal_config_frame,
+	.config_tile = aal_config_tile,
+	.tile_prepare = aal_tile_prepare,
+};
diff --git a/drivers/media/platform/mediatek/mdp3/mdp_alg_color.c b/drivers/media/platform/mediatek/mdp3/mdp_alg_color.c
new file mode 100644
index 000000000000..de7d79244122
--- /dev/null
+++ b/drivers/media/platform/mediatek/mdp3/mdp_alg_color.c
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2026 MediaTek Inc.
+ * Author: Dennis-YC Hsieh <dennis-yc.hsieh@mediatek.com>
+ */
+
+#include "mdp_reg_color.h"
+#include "mdp_tile_core.h"
+#include "mtk-mdp3-alg.h"
+
+struct color_frame_data {
+	bool relay;
+};
+
+static inline struct color_frame_data *color_frm_data(struct mdp_alg_path_tp *path,
+						      u32 n)
+{
+	return path->nodes[n].data;
+}
+
+static int color_prepare(struct mdp_alg_task *task,
+			 struct mdp_alg_path_tp *path, u32 n)
+{
+	struct color_frame_data *color_frm;
+
+	color_frm = kzalloc(sizeof(*color_frm), GFP_KERNEL);
+	if (!color_frm)
+		return -ENOMEM;
+	path->nodes[n].data = (void *)color_frm;
+
+	color_frm->relay = true;
+
+	return 0;
+}
+
+static int color_config_init(struct mdp_alg_task *task,
+			     struct mdp_alg_path_tp *path, u32 n)
+{
+	const phys_addr_t base_pa = path->nodes[n].comp->reg_base;
+	struct cmdq_pkt *pkt = task->pkts[path->path_id];
+
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_START,
+				  BIT(0), BIT(1) | BIT(0));
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_WIN_X_MAIN,
+				  0xFFFF0000, U32_MAX);
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_WIN_Y_MAIN,
+				  0xFFFF0000, U32_MAX);
+
+	/* Reset color matrix */
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_CM1_EN, 0, BIT(0));
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_CM2_EN, 0, BIT(0));
+
+	/* Enable interrupt */
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_INTEN, 0x7, 0x7);
+
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_OUT_SEL,
+				  0x333, 0x333);
+
+	return 0;
+}
+
+static int color_config_frame(struct mdp_alg_task *task,
+			      struct mdp_alg_path_tp *path, u32 n)
+{
+	const phys_addr_t base_pa = path->nodes[n].comp->reg_base;
+	struct cmdq_pkt *pkt = task->pkts[path->path_id];
+
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_START,
+				  0x3, MDP_COLOR_START_MASK);
+
+	return 0;
+}
+
+static int color_config_tile(struct mdp_alg_task *task,
+			     struct mdp_alg_path_tp *path,
+			     u32 n, u32 t)
+{
+	struct mdp_alg_tile_engine *tile = config_get_tile(task, path, n, t);
+	struct cmdq_pkt *pkt = task->pkts[path->path_id];
+	const phys_addr_t base_pa = path->nodes[n].comp->reg_base;
+	u32 width = tile->in.xe - tile->in.xs + 1;
+	u32 height = tile->in.ye - tile->in.ys + 1;
+
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_INTERNAL_IP_WIDTH,
+				  width, 0x00003FFF);
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_COLOR_INTERNAL_IP_HEIGHT,
+				  height, 0x00003FFF);
+
+	return 0;
+}
+
+const struct mdp_alg_comp_ops alg_ops_color = {
+	.comp_prepare = color_prepare,
+	.comp_init = color_config_init,
+	.config_frame = color_config_frame,
+	.config_tile = color_config_tile,
+};
