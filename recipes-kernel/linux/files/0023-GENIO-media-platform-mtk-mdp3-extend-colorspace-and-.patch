+	mdp->rx_cap_intf.rx_quantization = intf->quantization;
 
 	ret = mdp_capture_device_register(mdp);
 	if (ret)
@@ -909,14 +945,19 @@ static void mdp_cap_disconnect(struct hdmirx_capture_interface *intf)
 	mdp_capture_device_unregister(mdp);
 }
 
-static int mdp_cap_notify(struct hdmirx_capture_interface *intf, enum hdmirx_intf_notify,
+static int mdp_cap_notify(struct hdmirx_capture_interface *intf, enum hdmirx_intf_notify notify,
 			  void *data)
 {
 	struct mdp_dev *mdp = (struct mdp_dev *)intf->priv;
 
-	mdp->rx_cap_intf.rx_colorimetry = *(enum hdmirx_intf_colorimetry *)data;
+	if (notify == HDMIRX_INTF_NOTIFY_AVI_INFO_CHANGE) {
+		struct hdmirx_notify_avi_info_data *p_data =
+				(struct hdmirx_notify_avi_info_data *)data;
+		mdp->rx_cap_intf.rx_colorimetry = p_data->colorimetry;
+		mdp->rx_cap_intf.rx_quantization = p_data->quantization;
+	}
 
-	/* handle colorimetry change, e.g. enable HDR matrix */
+	/* handle avi info change, e.g. enable HDR matrix */
 
 	return 0;
 }
diff --git a/drivers/media/platform/mediatek/mdp3/mtk-mdp3-core.h b/drivers/media/platform/mediatek/mdp3/mtk-mdp3-core.h
