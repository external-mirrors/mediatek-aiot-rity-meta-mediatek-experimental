+	dev_dbg(&mdp->pdev->dev, "w/h/fr, cs/dc/cm/xfer/q: [%d/%d/%d][%d/%d/%d/%d/%d]\n",
+		intf->width, intf->height, intf->frame_rate,
+		intf->color_space, intf->deep_color, intf->colorimetry,
+		intf->xfer_func, intf->quantization);
 
 	mutex_lock(&mdp->cap_lock);
 
@@ -886,6 +920,8 @@ static int mdp_cap_probe(struct hdmirx_capture_interface *intf)
 	mdp->rx_cap_intf.rx_color_space = intf->color_space;
 	mdp->rx_cap_intf.rx_deep_color = intf->deep_color;
 	mdp->rx_cap_intf.rx_colorimetry = intf->colorimetry;
