From 5fdfc2df65c1ae5e949a6c1bde79af7507aa3bea Mon Sep 17 00:00:00 2001
From: Moudy Ho <moudy.ho@mediatek.com>
Date: Fri, 10 Apr 2026 08:28:50 +0800
Subject: [PATCH 23/35] GENIO: media: platform: mtk-mdp3: extend colorspace and
 bit depth support

Extend colorspace and bit depth support for the HDMI-RX capture device.
Add relevant frame information and implement configurations for HDR
and WROT components.

Change-Id: Id9a22447176189ba365b301243f6cd233aeddbdf
Signed-off-by: Moudy Ho <moudy.ho@mediatek.com>
---
 .../platform/mediatek/mdp3/mdp_alg_hdr.c      | 16 +++-
 .../platform/mediatek/mdp3/mdp_alg_wrot.c     | 45 +++++++++--
 .../platform/mediatek/mdp3/mdp_reg_wrot.h     | 12 +++
 .../platform/mediatek/mdp3/mtk-mdp3-capture.c | 81 ++++++++++++++-----
 .../platform/mediatek/mdp3/mtk-mdp3-core.h    |  2 +
 5 files changed, 126 insertions(+), 30 deletions(-)

diff --git a/drivers/media/platform/mediatek/mdp3/mdp_alg_hdr.c b/drivers/media/platform/mediatek/mdp3/mdp_alg_hdr.c
index 387d36bf9cbe..7f56afcf9025 100644
--- a/drivers/media/platform/mediatek/mdp3/mdp_alg_hdr.c
+++ b/drivers/media/platform/mediatek/mdp3/mdp_alg_hdr.c
@@ -48,6 +48,9 @@ static int hdr_prepare(struct mdp_alg_task *task,
 		       struct mdp_alg_path_tp *path, u32 n)
 {
 	struct hdr_frame_data *hdr_frm;
+	struct img_ipi_frameparam *param = task->cfg.param;
+	struct img_image_buffer *src_buf = &param->inputs[0].buffer;
+	u32 src_fmt = src_buf->format.colorformat;
 
 	hdr_frm = kzalloc(sizeof(*hdr_frm), GFP_KERNEL);
 	if (!hdr_frm)
@@ -57,8 +60,12 @@ static int hdr_prepare(struct mdp_alg_task *task,
 	if (task->cfg.param->type == MDP_STREAM_TYPE_BITBLT ||
 	    task->cfg.param->type == MDP_STREAM_TYPE_DUAL_BITBLT)
 		hdr_frm->relay = true;
+	else if (MDP_COLOR_IS_YUV(src_fmt))
+		hdr_frm->relay = true;
+	else
+		hdr_frm->relay = false;
 
-	hdr_frm->hdr_top = 0xB0B0001;
+	hdr_frm->hdr_top = 1;
 
 	return 0;
 }
@@ -99,12 +106,15 @@ static void hdr_rgb_to_yuv(struct mdp_alg_task *task,
 				  MDP_HDR_R2Y_01_MASK);
 	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_HDR_R2Y_02, 0x1000F3AB,
 				  MDP_HDR_R2Y_02_MASK);
-	if (src_buf->format.ycbcr_prof == MDP_YCBCR_PROFILE_BT709) {
+
+	if (src_buf->format.ycbcr_prof == MDP_YCBCR_PROFILE_RGB) {
+		/* To limited-range YUV */
 		cmdq_pkt_write_value_addr(pkt, base_pa + MDP_HDR_R2Y_03,
 					  0xF1771000, MDP_HDR_R2Y_03_MASK);
 		cmdq_pkt_write_value_addr(pkt, base_pa + MDP_HDR_R2Y_04,
 					  0xFE81, MDP_HDR_R2Y_04_MASK);
 	} else {
+		/* To full-range YUV */
 		cmdq_pkt_write_value_addr(pkt, base_pa + MDP_HDR_R2Y_03,
 					  0xF1781000, MDP_HDR_R2Y_03_MASK);
 		cmdq_pkt_write_value_addr(pkt, base_pa + MDP_HDR_R2Y_04,
@@ -115,7 +125,7 @@ static void hdr_rgb_to_yuv(struct mdp_alg_task *task,
 				  MDP_HDR_R2Y_05_MASK);
 	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_HDR_R2Y_06, 0,
 				  MDP_HDR_R2Y_06_MASK);
-	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_HDR_R2Y_07, 0,
+	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_HDR_R2Y_07, BIT(25),
 				  MDP_HDR_R2Y_07_MASK);
 	cmdq_pkt_write_value_addr(pkt, base_pa + MDP_HDR_R2Y_08, 0x200,
 				  MDP_HDR_R2Y_08_MASK);
diff --git a/drivers/media/platform/mediatek/mdp3/mdp_alg_wrot.c b/drivers/media/platform/mediatek/mdp3/mdp_alg_wrot.c
index 835ca4eeea69..783d9cb4d7ce 100644
--- a/drivers/media/platform/mediatek/mdp3/mdp_alg_wrot.c
+++ b/drivers/media/platform/mediatek/mdp3/mdp_alg_wrot.c
@@ -394,6 +394,11 @@ static void wrot_color_fmt(struct mdp_alg_task *task, struct mdp_alg_path_tp *pa
 		if (fmt == MDP_COLOR_RGB565 || fmt == MDP_COLOR_BGR565)
 			wrot_frm->mat_en = 0;
 
+	if (profile_in == MDP_YCBCR_PROFILE_BT2020 ||
+	    profile_in == MDP_YCBCR_PROFILE_FULL_BT709 ||
+	    profile_in == MDP_YCBCR_PROFILE_FULL_BT2020)
+		goto wrot_csc_done;
+
 	/*
 	 * 4'b0000: RGB to JPEG
 	 * 4'b0010: RGB to BT601
@@ -408,11 +413,6 @@ static void wrot_color_fmt(struct mdp_alg_task *task, struct mdp_alg_path_tp *pa
 	 * 4'b1100: BT709 to BT601
 	 * 4'b1101: BT601 to BT709
 	 */
-	if (profile_in == MDP_YCBCR_PROFILE_BT2020 ||
-	    profile_in == MDP_YCBCR_PROFILE_FULL_BT709 ||
-	    profile_in == MDP_YCBCR_PROFILE_FULL_BT2020)
-		profile_in = MDP_YCBCR_PROFILE_BT709;
-
 	if (wrot_frm->mat_en == 1) {
 		if (profile_in == MDP_YCBCR_PROFILE_BT601) {
 			wrot_frm->mat_sel = 6;
@@ -427,6 +427,10 @@ static void wrot_color_fmt(struct mdp_alg_task *task, struct mdp_alg_path_tp *pa
 				wrot_frm->mat_sel = 7;
 			else
 				wrot_frm->mat_sel = 0;
+		} else if (profile_in == MDP_YCBCR_PROFILE_RGB &&
+			profile_out == MDP_YCBCR_PROFILE_RGB) {
+			wrot_frm->mat_en = 1;
+			wrot_frm->mat_sel = 5;
 		} else {
 			dev_err(dev, "unknown profile conversion %x",
 				profile_in);
@@ -478,6 +482,7 @@ static void wrot_color_fmt(struct mdp_alg_task *task, struct mdp_alg_path_tp *pa
 		}
 	}
 
+wrot_csc_done:
 	if (MDP_COLOR_IS_10BIT_PACKED(p->inputs[0].buffer.format.colorformat) &&
 	    !MDP_COLOR_IS_10BIT_PACKED(fmt)) {
 		wrot_frm->mat_en = 1;
@@ -615,6 +620,7 @@ static s32 wrot_config_frame(struct mdp_alg_task *task,
 	u32 uv_xsel, uv_ysel;
 	u32 preultra, alpha;
 	u32 scan_10bit = 0, bit_num = 0, pending_zero = 0, pvric = 0;
+	u32 mat_ctl = BIT(2);
 
 	if (!wrot)
 		return -EINVAL;
@@ -734,9 +740,34 @@ static s32 wrot_config_frame(struct mdp_alg_task *task,
 	cmdq_pkt_write_value_addr(pkt, base_pa + VIDO_STRIDE_V,
 				  wrot_frm->uv_stride, U32_MAX);
 
+	mat_ctl = (wrot_frm->mat_sel << 4) + (wrot_frm->mat_en << 0);
+	if (wrot_frm->hdr_r2y) {
+		u32 profile_in = p->inputs[0].buffer.format.ycbcr_prof;
+		u32 profile_out = dst_buf->format.ycbcr_prof;
+
+		/* Limited RGB -> HDR R2Y -> WROT Y2R (limited)*/
+		if (profile_in == MDP_YCBCR_PROFILE_RGB &&
+		    profile_out == MDP_YCBCR_PROFILE_RGB) {
+			mat_ctl |= BIT(1);
+
+			/* Set matrix coefficient */
+			cmdq_pkt_write_value_addr(pkt, base_pa + VIDO_MAT_RMY,
+						  (4096 << 16), U32_MAX);
+			cmdq_pkt_write_value_addr(pkt, base_pa + VIDO_MAT_RMV,
+						  (6450 << 16) + 4096, U32_MAX);
+			cmdq_pkt_write_value_addr(pkt, base_pa + VIDO_MAT_GMY,
+						  0xfcfdf883, U32_MAX);
+			cmdq_pkt_write_value_addr(pkt, base_pa + VIDO_MAT_BMY,
+						  (4096 << 16) + 7601, U32_MAX);
+			cmdq_pkt_write_value_addr(pkt, base_pa + VIDO_MAT_BMV,
+						  0, U32_MAX);
+			cmdq_pkt_write_value_addr(pkt, base_pa + VIDO_MAT_PREADD,
+						  (384 << 10) + 384, U32_MAX);
+		}
+	}
+
 	cmdq_pkt_write_value_addr(pkt, base_pa + VIDO_MAT_CTRL,
-				  (wrot_frm->mat_sel << 4) +
-				  (wrot_frm->mat_en << 0), U32_MAX);
+				  mat_ctl, U32_MAX);
 
 	cmdq_pkt_write_value_addr(pkt, base_pa + VIDO_DITHER,
 				  0xff000000, U32_MAX);
diff --git a/drivers/media/platform/mediatek/mdp3/mdp_reg_wrot.h b/drivers/media/platform/mediatek/mdp3/mdp_reg_wrot.h
index 3d3dd4842284..f800e4ab367a 100644
--- a/drivers/media/platform/mediatek/mdp3/mdp_reg_wrot.h
+++ b/drivers/media/platform/mediatek/mdp3/mdp_reg_wrot.h
@@ -29,6 +29,12 @@
 #define VIDO_ROT_EN                 0x07c
 #define VIDO_FIFO_TEST              0x080
 #define VIDO_MAT_CTRL               0x084
+#define VIDO_MAT_RMY                0x08C
+#define VIDO_MAT_RMV                0x090
+#define VIDO_MAT_GMY                0x094
+#define VIDO_MAT_BMY                0x098
+#define VIDO_MAT_BMV                0x09C
+#define VIDO_MAT_PREADD             0x0A0
 #define VIDO_PVRIC                  0x0d8
 #define VIDO_SCAN_10BIT             0x0dc
 #define VIDO_PENDING_ZERO           0x0e0
@@ -63,6 +69,12 @@
 #define VIDO_ROT_EN_MASK                0x00000001
 #define VIDO_FIFO_TEST_MASK             0x00000fff
 #define VIDO_MAT_CTRL_MASK              0x000000f3
+#define VIDO_MAT_RMY_MASK               0x1FFF1FFF
+#define VIDO_MAT_RMV_MASK               0x1FFF1FFF
+#define VIDO_MAT_GMY_MASK               0x1FFF1FFF
+#define VIDO_MAT_BMY_MASK               0x1FFF1FFF
+#define VIDO_MAT_BMV_MASK               0x00001FFF
+#define VIDO_MAT_PREADD_MASK            0x1FF7FDFF
 #define VIDO_PVRIC_MASK                 0xffffffff
 #define VIDO_SCAN_10BIT_MASK            0x0000000f
 #define VIDO_PENDING_ZERO_MASK          0x07ffffff
diff --git a/drivers/media/platform/mediatek/mdp3/mtk-mdp3-capture.c b/drivers/media/platform/mediatek/mdp3/mtk-mdp3-capture.c
index 71d4e7888432..fd2e9e3149f0 100644
--- a/drivers/media/platform/mediatek/mdp3/mtk-mdp3-capture.c
+++ b/drivers/media/platform/mediatek/mdp3/mtk-mdp3-capture.c
@@ -79,18 +79,55 @@ static int mdp_cap_g_fmt_mplane(struct file *file, void *fh,
 }
 
 static void _mdp_cap_fill_v4l2_format(struct v4l2_pix_format_mplane *pix_mp,
-				      const struct mdp_format *fmt)
+				      const struct mdp_format *fmt, struct mdp_dev *mdp)
 {
-	if (MDP_COLOR_IS_YUV(fmt->mdp_color)) {
+	switch (mdp->rx_cap_intf.rx_colorimetry) {
+	case HDMIRX_INTF_COLORIMETRY_OPRGB:
+	case HDMIRX_INTF_COLORIMETRY_SRGB:
+	case HDMIRX_INTF_COLORIMETRY_DEFAULT_RGB:
+		pix_mp->colorspace = V4L2_COLORSPACE_SRGB;
+		pix_mp->ycbcr_enc = V4L2_YCBCR_ENC_601;
+		break;
+	case HDMIRX_INTF_COLORIMETRY_BT709:
+	case HDMIRX_INTF_COLORIMETRY_XVYCC709:
 		pix_mp->colorspace = V4L2_COLORSPACE_REC709;
-		pix_mp->xfer_func = V4L2_XFER_FUNC_709;
 		pix_mp->ycbcr_enc = V4L2_YCBCR_ENC_709;
+		break;
+	case HDMIRX_INTF_COLORIMETRY_BT2020_YC_CBC_CRC:
+	case HDMIRX_INTF_COLORIMETRY_BT2020_RGB_YCBCR:
+		pix_mp->colorspace = V4L2_COLORSPACE_BT2020;
+		pix_mp->ycbcr_enc = V4L2_YCBCR_ENC_BT2020;
+		break;
+	default:
+		pix_mp->colorspace = V4L2_COLORSPACE_JPEG;
+		pix_mp->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+		break;
+	}
+
+	switch (mdp->rx_cap_intf.rx_xfer_func) {
+	case HDMIRX_INTF_XFER_SDR:
+		pix_mp->xfer_func = V4L2_XFER_FUNC_SRGB;
+		break;
+	case HDMIRX_INTF_XFER_HDR:
+	case HDMIRX_INTF_XFER_HDR10:
+	case HDMIRX_INTF_XFER_HLG:
+		pix_mp->xfer_func = V4L2_XFER_FUNC_SMPTE2084;
+		break;
+	default:
+		pix_mp->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+		break;
+	}
+
+	switch (mdp->rx_cap_intf.rx_quantization) {
+	case HDMIRX_INTF_QUANTIZED_RANGE_LIMITED:
 		pix_mp->quantization = V4L2_QUANTIZATION_LIM_RANGE;
-	} else {
-		pix_mp->colorspace = V4L2_COLORSPACE_SRGB;
-		pix_mp->xfer_func = V4L2_XFER_FUNC_709;
-		pix_mp->ycbcr_enc = V4L2_YCBCR_ENC_709;
+		break;
+	case HDMIRX_INTF_QUANTIZED_RANGE_FULL:
 		pix_mp->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+		break;
+	default:
+		pix_mp->quantization = V4L2_QUANTIZATION_LIM_RANGE;
+		break;
 	}
 }
 
@@ -102,7 +139,6 @@ static int mdp_cap_s_fmt_mplane(struct file *file, void *fh,
 	struct mdp_frame *capture;
 	const struct mdp_format *fmt;
 	struct v4l2_pix_format_mplane *pix_mp = &f->fmt.pix_mp;
-	enum mdp_ycbcr_profile profile;
 
 	fmt = mdp_try_fmt_mplane(ctx->mdp_dev, f, &ctx->curr_param, ctx->id);
 
@@ -112,16 +148,12 @@ static int mdp_cap_s_fmt_mplane(struct file *file, void *fh,
 	if (vb2_is_busy(&ctx->cap_q))
 		return -EBUSY;
 
-	_mdp_cap_fill_v4l2_format(pix_mp, fmt);
+	_mdp_cap_fill_v4l2_format(pix_mp, fmt, ctx->mdp_dev);
 	frame->format = *f;
 	frame->mdp_fmt = fmt;
 	frame->usage = V4L2_TYPE_IS_OUTPUT(f->type) ?
 		MDP_BUFFER_USAGE_HDMI_RX : MDP_BUFFER_USAGE_MDP;
-	if (V4L2_TYPE_IS_OUTPUT(f->type) && MDP_COLOR_IS_RGB(fmt->mdp_color))
-		profile = MDP_YCBCR_PROFILE_RGB;
-	else
-		profile = mdp_map_ycbcr_prof_mplane(f, fmt->mdp_color);
-	frame->ycbcr_prof = profile;
+	frame->ycbcr_prof = mdp_map_ycbcr_prof_mplane(f, fmt->mdp_color);
 
 	capture = ctx_get_frame(ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
 	if (V4L2_TYPE_IS_OUTPUT(f->type)) {
@@ -157,7 +189,7 @@ static int mdp_cap_try_fmt_mplane(struct file *file, void *fh,
 	if (!fmt)
 		return -EINVAL;
 
-	_mdp_cap_fill_v4l2_format(pix_mp, fmt);
+	_mdp_cap_fill_v4l2_format(pix_mp, fmt, ctx->mdp_dev);
 
 	return 0;
 }
@@ -875,8 +907,10 @@ static int mdp_cap_probe(struct hdmirx_capture_interface *intf)
 	if (mdp->cap_open_count > 0)
 		return -EBUSY;
 
-	dev_dbg(&mdp->pdev->dev, "w[%u], h[%u], fr[%u], cs[%d]\n",
